# ---------------------------------------------------------------------------
# Vorlage. Kopieren nach .env (steht in .gitignore) und ausfuellen.
# Im Repo liegen nur Platzhalter, niemals echte Werte.
# ---------------------------------------------------------------------------

# --- Datenbank -------------------------------------------------------------
# Lokal: der Container aus docker-compose.yml (Port 55432, nicht 5432).
# Produktiv: die Verbindungszeichenfolge von Neon, mit ?sslmode=require.
DATABASE_URL="postgresql://notebooklm:notebooklm_local_dev@localhost:55432/notebooklm?schema=public"

# Eigene Datenbank fuer die Tests. Die Testlaeufe leeren alle Tabellen -
# ohne diese Trennung waeren die lokalen Demodaten nach jedem `npm test` weg.
TEST_DATABASE_URL="postgresql://notebooklm:notebooklm_local_dev@localhost:55432/notebooklm_test?schema=public"

# --- Auth ------------------------------------------------------------------
# Mindestens 32 Zeichen. Erzeugen mit:  openssl rand -base64 48
JWT_SECRET="bitte-ersetzen-mindestens-32-zeichen-langes-geheimnis"

# --- KI --------------------------------------------------------------------
# Schluessel aus Google AI Studio (https://aistudio.google.com/apikey).
# Neuere Schluessel beginnen mit "AQ.", aeltere mit "AIza" - beide funktionieren.
GEMINI_API_KEY="hier-einfuegen"

# --- Server ----------------------------------------------------------------
PORT=4310
NODE_ENV=development
LOG_LEVEL=info

# Kommagetrennte Liste erlaubter Frontend-Herkuenfte fuer CORS.
CORS_ORIGIN="http://localhost:5310"

# --- Frontend (Vite, Praefix VITE_ ist Pflicht) -----------------------------
# Basis-URL der API. Leer lassen fuer den lokalen Vite-Proxy.
VITE_API_URL=""

# ---------------------------------------------------------------------------
# Nur fuer das Anlegen und Aktualisieren der Infrastruktur ueber die
# Anbieter-APIs. Die Anwendung selbst liest diese beiden Werte nie.
# ---------------------------------------------------------------------------

# Neon: Console -> oben rechts Profil -> "Account settings" -> "API keys"
NEON_API_KEY=""

# Render: Dashboard -> Avatar -> "Account Settings" -> "API Keys" -> "Create API Key"
RENDER_API_KEY=""
