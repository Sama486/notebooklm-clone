// Datenmodell des NotebookLM-Klons.
//
// TRENNLINIE ZWISCHEN NUTZERN: `userId` steht ausschließlich am Notebook.
// Quellen, Abschnitte und Nachrichten tragen bewusst KEIN `userId` - sie erben
// die Trennung über ihr Notebook. Daraus folgt eine Regel, die im gesamten
// Zugriffspfad diszipliniert eingehalten wird (siehe src/data/notebookAccess.ts):
//
//   Erst das Notebook gegen `userId` auflösen, dann Kindobjekte über
//   `notebookId` einschränken. Niemals eine Quelle, einen Abschnitt oder eine
//   Nachricht direkt über die eigene ID laden.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  createdAt    DateTime   @default(now())
  notebooks    Notebook[]
}

model Notebook {
  id        String   @id @default(uuid())
  userId    String // Trennlinie zwischen Nutzern; jede Abfrage geht darüber
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sources  Source[]
  messages Message[]
  chunks   Chunk[]
  notes    Note[]

  // Listenabfrage ist immer (userId, createdAt desc) -> zusammengesetzter Index.
  @@index([userId, createdAt])
}

model Source {
  id          String   @id @default(uuid())
  notebookId  String
  title       String
  type        String // "pdf" | "text" | "url"
  originalUrl String?
  content     String   @db.Text // extrahierter Volltext - Grundlage der Zeichen-Positionen
  // Zeichen-Positionen der Seitenanfänge aus der PDF-Extraktion. Leer bei Text-
  // und URL-Quellen, die keine Seiten haben. Trägt die Seitenzahl im Zitat.
  pageBreaks  Int[]
  fileData    Bytes? // Original-PDF; bewusst in der DB, siehe README
  sizeBytes   Int
  status      String   @default("pending") // pending | processing | ready | failed
  error       String?
  chunkCount  Int      @default(0)
  selected    Boolean  @default(true)
  createdAt   DateTime @default(now())

  notebook Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  chunks   Chunk[]

  @@index([notebookId])
}

model Chunk {
  id         String  @id @default(uuid())
  sourceId   String
  notebookId String // denormalisiert: die Ähnlichkeitssuche filtert immer danach
  index      Int
  content    String  @db.Text
  charStart  Int // Position im Volltext der Quelle - trägt die Zitatfunktion
  charEnd    Int
  page       Int?
  tokenCount Int
  embedding  Float[] // exakter Durchlauf statt Vektor-Index; Begründung + Messung im README

  source   Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  notebook Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)

  @@index([notebookId])
  @@index([sourceId])
}

model Message {
  id         String   @id @default(uuid())
  notebookId String
  role       String // "user" | "assistant"
  content    String   @db.Text
  citations  Json? // [{ marker, chunkId, sourceId, sourceTitle, charStart, charEnd, snippet }]
  createdAt  DateTime @default(now())

  notebook Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)

  @@index([notebookId, createdAt])
}

// Embedding-Cache. Liegt in der Datenbank und nicht im Prozessspeicher, damit
// mehrere Instanzen ihn teilen (Abschnitt "Skalierbarkeit" im README).
// Schlüssel ist ein SHA-256 über Modellname + Text.
model EmbeddingCache {
  hash      String   @id
  model     String
  embedding Float[]
  createdAt DateTime @default(now())
}

// Zähler für die Anmeldeversuche je Konto.
//
// Liegt in der Datenbank und nicht im Prozessspeicher, weil ein Zähler im
// Prozess bei mehreren Instanzen nichts begrenzt: jede zählt für sich, und
// das effektive Limit vervielfacht sich. Gemessen gegen die Produktion - die
// Antworten trugen unterschiedliche Fensterenden, also mehrere Zähler.
// Begründung und Messung im README.
model LoginAttempt {
  key       String   @id // "login:<e-mail>"
  count     Int      @default(0)
  expiresAt DateTime

  // Für das Aufräumen abgelaufener Fenster.
  @@index([expiresAt])
}

// Eine gespeicherte Notiz - meist eine Antwort, die der Nutzer behalten will.
//
// Trägt wie Quellen und Nachrichten KEIN userId: die Trennung wird über das
// Notebook geerbt. Der Zugriffspfad ist derselbe wie überall - erst Notebook
// gegen userId auflösen, dann über notebookId einschränken.
model Note {
  id         String   @id @default(uuid())
  notebookId String
  title      String
  content    String   @db.Text
  // Die Belege der gespeicherten Antwort, damit die Chips auch in der Notiz
  // anklickbar bleiben. Gleiche Form wie bei Message.
  citations  Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  notebook Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)

  // Die Liste wird immer als (notebookId, createdAt desc) abgefragt.
  @@index([notebookId, createdAt])
}
